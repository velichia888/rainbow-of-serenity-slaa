rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Google accounts allowed to remove posts. Keep in sync with
    // MODERATORS in app/index.html.
    function isModerator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['goodmanona@gmail.com', 'rainbowofserenityslaa@gmail.com'];
    }

    function ratePath() {
      return /databases/$(database)/documents/rate/$(request.auth.uid);
    }

    // Community feed: anyone can read. Posting needs the app's invisible
    // anonymous sign-in, one post per device every 30 seconds, and no links.
    // Only moderators can remove posts; nobody can edit them.
    match /feed/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && !request.resource.data.text.lower().matches('(?s).*(https?://|www[.]).*')
        && !request.resource.data.name.lower().matches('(?s).*(https?://|www[.]).*')
        && request.resource.data.createdAt == request.time
        // The same write must record this post time for the device...
        && getAfter(ratePath()).data.last == request.time
        // ...and the device's previous post must be at least 30 seconds old.
        && (!exists(ratePath())
            || request.time > get(ratePath()).data.last + duration.value(30, 's'));
      allow delete: if isModerator();
      allow update: if false;
    }

    // Each device's last post time, written alongside every post.
    match /rate/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time;
    }

    // Anonymous visitor count: one number per day (visits/YYYY-MM-DD).
    // Visitors can only add 1 to it; only moderators can read it.
    match /visits/{day} {
      allow read: if isModerator();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // A gallery photo: a small JPEG stored as text, plus an optional caption
    // with no links.
    function isPhoto(d) {
      return d.image is string
        && d.image.size() <= 400000
        && d.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && d.caption is string
        && d.caption.size() <= 120
        && !d.caption.lower().matches('(?s).*(https?://|www[.]).*');
    }

    // Gallery photos members send in. Only moderators can see them, and they
    // share the feed's one-post-per-device-every-30-seconds limit.
    match /gallerySubmissions/{photoId} {
      allow read, delete: if isModerator();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['image', 'caption', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isPhoto(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(ratePath()).data.last == request.time
        && (!exists(ratePath())
            || request.time > get(ratePath()).data.last + duration.value(30, 's'));
      allow update: if false;
    }

    // Approved gallery photos: anyone can see them. Only moderators can add
    // (by approving a submission) or remove them.
    match /gallery/{photoId} {
      allow read: if true;
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly(['image', 'caption', 'createdAt'])
        && isPhoto(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow delete: if isModerator();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
